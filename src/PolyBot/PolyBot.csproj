<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  
	<!-- General properties -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PolyBot</RootNamespace>
	
	<!-- Build properties -->
	<BaseOutputPath>..\..\bin</BaseOutputPath>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<IncludeSymbols>True</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<DebugType>embedded</DebugType>
	<SignAssembly>False</SignAssembly>

    <!-- NuGet package metadata properties -->
	<Title>PolyBot</Title>
	<Version>1.0.0</Version>
	<Authors>Rikitav Tim4ik</Authors>
	<Company>Rikitav Tim4ik</Company>
	<RepositoryUrl>https://github.com/Rikitav/Telegrator</RepositoryUrl>
	<PackageProjectUrl>https://rikitav.github.io/telegrator.docs</PackageProjectUrl>
	<PackageTags>telegram;bot;mediator;attributes;aspect;hosting;host;framework;easy;simple;handlers;webhooks</PackageTags>

	<!--PackageIcon>polybot.png</PackageIcon-->
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE</PackageLicenseFile>

	  <!-- Docs & API reference -->
	<EnableNETAnalyzers>True</EnableNETAnalyzers>
	<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<DocumentationFile>..\..\api-reference\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <!-- Project dependencies -->
  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.10.3.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Packs -->
  <ItemGroup>
  	<None Include="..\..\README.md" Pack="True" PackagePath="\" />
  	<None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
  	<!--None Include="..\..\docs\logo\polybot.png" Pack="True" PackagePath="\" /-->
  </ItemGroup>

  <!-- Featured analuzers -->
  <ItemGroup>
    <ProjectReference Include="..\PolyBot.InternalsGenerators\PolyBot.InternalsGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PolyBot.SourceGenerators\PolyBot.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Shipped analyzers -->
  <ItemGroup>
	<None Include="..\..\bin\$(Configuration)\netstandard2.0\PolyBot.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
